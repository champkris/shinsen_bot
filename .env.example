LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=your_azure_endpoint_here
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_key_here
AZURE_TIER=standard

# Comma-separated list of LINE group IDs to send notifications when data is updated
# Example: NOTIFICATION_GROUP_IDS=Cxxxxxxxxxxxxx,Cyyyyyyyyyyyyy
NOTIFICATION_GROUP_IDS=

# Auto-send notification to groups after successful extraction (true/false, default: true)
AUTO_NOTIFY=true

# Comma-separated LINE IDs that receive watchdog alerts when a day has no data.
# Accepts a group ID (Cxxx) or a user ID (Uxxx) for a 1:1 chat with the bot — useful
# when the alert should reach an admin without going to a working group.
# Kept separate from NOTIFICATION_GROUP_IDS so ops alerts do not reach customer groups.
# Leave empty and the watchdog only logs; pair that with a scheduler calling
# /watchdog?strict=1 (409 when data is missing) to alert by email instead.
ALERT_GROUP_IDS=

# Watchdog: how many days back to check, and the Bangkok hour after which the current
# day counts as overdue (default 7 days / 15:00)
WATCHDOG_LOOKBACK_DAYS=7
WATCHDOG_CUTOFF_HOUR=15

# Run the watchdog once shortly after startup (true/false, default: true)
WATCHDOG_ON_BOOT=true
